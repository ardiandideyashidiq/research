@article{Shin2025trustworthygovernancemisinformation,
  title = {Trustworthy AI and the governance of misinformation: policy design and accountability in the fact-checking system},
  author = {Emily Y. Shin and Donghee Shin},
  journal = {Transforming Government: People, Process and Policy},
  year = {2025},
  volume = {20},
  number = {3},
  pages = {536-554},
  doi = {10.1108/tg-09-2025-0273},
  url = {https://doi.org/10.1108/tg-09-2025-0273},
  abstract = {Purpose This study aims to examine the governance of artificial intelligence (AI)-enabled fact-checking systems as sociotechnical infrastructures that shape the production, validation and contestation of truth in digital public spheres. It identifies regulatory approaches and institutional mechanisms that foster transparency, accountability and epistemic legitimacy in the algorithmic governance of misinformation. Design/methodology/approach Adopting a conceptual and policy-oriented approach, this study draws from policy studies, regulatory theory and AI ethics. It analyzes emerging governance models across diverse jurisdictions and international organizations, situating fact-checking systems within broader epistemic and normative contexts. This study also follows the PRISMA (Preferred Reporting Items for Systematic Reviews and Meta-Analyses) protocol to structure and transparently report the selection process of reviewed documents and policy sources, ensuring methodological rigor and replicability. Findings AI-based fact-checking systems are not neutral; they embed assumptions about knowledge, authority and evidentiary standards. Effective governance demands inclusive, adaptive frameworks that prioritize procedural justice and public accountability. This study highlights innovative institutional designs such as participatory audits, multi-stakeholder oversight bodies and algorithmic inoculation strategies. Research limitations/implications The findings provide actionable guidance for policymakers, regulators and platform designers seeking to enhance the trustworthiness of AI verification systems. By emphasizing procedural transparency, participatory governance and epistemic inclusion, the framework informs policy development that balances innovation with accountability, supporting the design of AI systems aligned with democratic values and public trust. Originality/value This study develops a multidimensional framework for governing algorithmic truth by integrating legal mandates, sociotechnical infrastructures and epistemic norms. By reframing AI fact-checking as a contested epistemic infrastructure, it contributes to critical debates on algorithmic accountability, epistemic justice and the democratic governance of truth in AI-mediated societies.}
}

@article{Voinea2026syntheticmediadeepfakes,
  title = {Synthetic Media: Deepfakes, AI-Generated Content, and Authenticity in the Digital Society},
  author = {Dan Valeriu Voinea},
  journal = {Encyclopedia},
  year = {2026},
  volume = {6},
  number = {8},
  pages = {175},
  doi = {10.3390/encyclopedia6080175},
  url = {https://doi.org/10.3390/encyclopedia6080175},
  abstract = {Synthetic media are digital artifacts (image, video, audio, text, or multimodal content) that are wholly or partly generated or materially manipulated by artificial intelligence (AI), particularly by deep-learning models. In consequence, their form, source, identity signal, or evidentiary relation to recorded events becomes partly or wholly artificial. A deepfake is the best-known subclass: AI-generated or AI-manipulated image, audio, or video content (including audio-only voice clones and still images) that realistically depicts an existing or fictitious person, object, place, or event and could falsely appear to be authentic. Contemporary scholarly and legal usage defines deepfakes by their technological origin and their capacity to deceive rather than by the creator’s intent, so disclosed and beneficial applications (accessibility, dubbing, entertainment, and research) are synthetic media as well. They are distinguished from cheapfakes (or shallowfakes), which achieve deception through conventional, non-AI editing such as selective cropping, slowing, or recontextualization. The social significance of synthetic media is not intrinsic but depends on consent, context, disclosure, and distribution, and on the institutional conditions under which audiences judge authenticity across the expanding volume of AI-generated content (AIGC) in the digital society.}
}

