@article{Zhang2026studyethicaldilemmas,
  title = {A Study on the Ethical Dilemmas and Governance Paths of Generative AI Intervention in News Production: An Analysis Based on a Case Study of South Korean Media},
  author = {Hanwen Zhang},
  journal = {Journal of Sociology and Education},
  year = {2026},
  volume = {2},
  number = {1},
  doi = {10.63887/jse.2026.2.1.78},
  url = {https://www.sci-open.net/index.php/JSE/article/view/10781},
  abstract = {The Introduction Of Generative Artificial Intelligence (Gai) In News Generation Is a Paradigm In Journalism That Radically Changes The Workflows And Content Generation Procedures And The Epistemological Background Of News. The Present Paper Discusses The Ethical Issues That The Implementation Of Gai Brings Using a Broad Overview Of South Korea Media Cases, Which Are Especially Didactic Because The Nation Is Both a Technological Early Adopter And a Jurisdiction With Some Of The Strongest Copyright Laws. This Study Will Use The Qualitative Framework Of a Case Study, Based On The Social Amplification Of Risk Model, To Examine Four Significant Cases Including The Mk Ax Ai News Podcast, Mai Morning Briefing, The Kbs-Naver Partnership Paradox, With Simultaneous Litigation And Collaboration, The Afp Fact-Check Investigations Of Ai-Generated Fake News, And The Joint Lawsuit Between Kbs, Mbc And Sbs Against Openai. The Analysis Shows That There Are Three Major Points Of a Contradiction In The Ethical Domain, Namely Unresolved Copyright Sovereignty Dilemmas Between International Ai Sites And National Content Creators, Gai Weaponization As a Tool To Generate Disinformation, And The Conflict Between Efficiency And Journalistic Originality. The Research Finding Is That Governance Should Be Effective With Multi-Stakeholder Orient Attitude That Surpass Voluntary Provisions To Legal Regulations Without Compromising The Complementary Bond Among Human Judgment And Technological Enhancement.}
}

@article{Moon2024digitalcrimeonline,
  title = {Digital Sex Crime, Online Misogyny, and Digital Feminism in South Korea},
  author = {Minyoung Moon},
  journal = {Georgetown Journal of International Affairs},
  year = {2024},
  volume = {25},
  number = {1},
  pages = {186-192},
  doi = {10.1353/gia.2024.a934902},
  url = {https://doi.org/10.1353/gia.2024.a934902},
  abstract = {Abstract: In 2017, the South Korean government announced the "Comprehensive Countermeasures Against Digital Sex Crime" as part of a collaborative effort among multiple ministries to establish a prevention system for digital sex crimes. Given the widespread occurrence of these crimes and the heightened presence in South Korea (Korea) since the late 1990s, this action was long overdue. Korea is known as one of the most digitally advanced nations globally and has faced both challenges and opportunities in addressing gender-based violence facilitated by technology in recent decades. This paper discusses the development and diversification of gender-based violence, aided by evolving digital technologies, in Korea. Additionally, it explores how Korean women have responded to pervasive issues of digital sex crimes and online misogyny with the support of an increasing population of digital feminists. After examining the obstacles, the paper concludes with suggestions on how to overcome these difficulties, emphasizing efforts from both the government and private sectors.}
}

