  title = {Reconstructing Legal Protection for Victims of Deepfake Abuse through a Victim-Oriented Justice Approach},
  author = {Mohammad Arief Widyanto and Risky Waldo and Tubagus Ahmad Ramadan},
  journal = {Jurnal Kepastian Hukum dan Keadilan},
  year = {2026},
