  title = {PERLINDUNGAN HUKUM HAK PUBLISITAS TERHADAP EKSPLOITASI TEKNOLOGI DEEPFAKE AI DALAM KONTEKS KOMERSIAL MENURUT HUKUM POSITIF DI INDONESIA},
