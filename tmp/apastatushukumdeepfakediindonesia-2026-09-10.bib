  title = {The Era of Artificial Intelligence: Examining Indonesia’s Adaptability and Legal Challenges},
  author = {Maulana Hafiz},
  journal = {Law and Humanities Quarterly Reviews},
  year = {2024},
  volume = {3},
  number = {3},
